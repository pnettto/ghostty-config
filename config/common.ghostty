# Comfortable text and breathing room.
font-size = 14
adjust-cell-height = 8%
window-padding-x = 12
window-padding-y = 10

# Frosted glass and inactive splits.
background-opacity = 0.9
background-blur = true
unfocused-split-opacity = 0.8

# Drop-down terminal.
keybind = global:ctrl+shift+space=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 45%
quick-terminal-autohide = true

# Reload without punctuation.
keybind = super+shift+r=reload_config
